---
import TurnstileWidget from "./TurnstileWidget.astro";
---

<form class="form-panel" method="post" action="/api/subscribe">
	<h2>Subscribe to the journal</h2>
	<p class="form-hint">Double opt-in. One note when new entries ship. No patient details in replies.</p>
	<label for="subscribe-email">Email</label>
	<input id="subscribe-email" name="email" type="email" required autocomplete="email" />
	<TurnstileWidget />
	<button type="submit">Request confirmation</button>
</form>