---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { getProfile, profileLinks } from "../lib/profile";

const profile = await getProfile();
const links = profileLinks(profile.data);
const notes = (await getCollection("notes", ({ data }) => !data.draft))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 5);
const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
	(a, b) => b.data.updated.valueOf() - a.data.updated.valueOf(),
);

const titleParts = [profile.data.name, profile.data.role].filter(Boolean);
const pageTitle = titleParts.length ? titleParts.join(" · ") : "dom.doctor";
---

<BaseLayout title={pageTitle} description={profile.data.focus || profile.data.shortBio || pageTitle} current="home">
	<h1>{profile.data.name || "Name (fill in profile)"}</h1>
	<p class="notebook-meta">
		{profile.data.role || "Role"}
		{profile.data.focus ? ` · ${profile.data.focus}` : ""}
	</p>
	{
		profile.data.shortBio ? (
			<p>{profile.data.shortBio}</p>
		) : (
			<p>
				Short introduction goes in <code>src/content/profile/index.md</code> (<code>shortBio</code>).
			</p>
		)
	}

	{
		links.length ? (
			<p>
				{links.map((link, i) => (
					<>
						{i > 0 ? " · " : ""}
						<a href={link.href}>{link.label}</a>
					</>
				))}
			</p>
		) : null
	}

	<h2>Bench · projects</h2>
	<table class="status-table">
		<thead>
			<tr>
				<th>project</th>
				<th>status</th>
				<th>audience</th>
				<th>updated</th>
			</tr>
		</thead>
		<tbody>
			{
				projects.map((project) => (
					<tr>
						<td>
							<a href={`/projects/${project.id}`}>{project.data.title}</a>
						</td>
						<td>{project.data.status}</td>
						<td>{project.data.audience}</td>
						<td>{project.data.updated.toISOString().slice(0, 10)}</td>
					</tr>
				))
			}
		</tbody>
	</table>

	<h2>Latest journal entries</h2>
	<ul class="entry-list">
		{
			notes.map((note) => (
				<li>
					<a href={`/notes/${note.id}`}>{note.data.title}</a>
					<span class="meta">
						{note.data.date.toISOString().slice(0, 10)} · {note.data.status} · {note.data.setting}
					</span>
				</li>
			))
		}
	</ul>
</BaseLayout>