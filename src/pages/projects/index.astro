---
export const prerender = true;

import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
	(a, b) => b.data.updated.valueOf() - a.data.updated.valueOf(),
);
---

<BaseLayout title="Projects" current="projects">
	<h1>Projects</h1>
	<p class="notebook-meta">Catalog of repositories worth showing. Canonical code stays on GitHub.</p>
	<ul class="entry-list">
		{
			projects.map((project) => (
				<li>
					<a href={`/projects/${project.id}`}>{project.data.title}</a>
					<span class="meta">
						{project.data.status} · {project.data.role} · {project.data.summary}
					</span>
				</li>
			))
		}
	</ul>
</BaseLayout>